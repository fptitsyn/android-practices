<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <Button
        android:id="@+id/btnCheckCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Проверить разрешение камеры" />

    <Button
        android:id="@+id/btnCheckMicrophone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Проверить разрешение микрофона"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvPermissionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Статус: не проверено"
        android:layout_marginTop="24dp"/>

</LinearLayout>